REDPANDA_PASSWORD=superpass123

# Redpanda SASL Authentication
RP_ENABLE_SASL=true
RP_SUPERUSER=superuser
RP_SUPERPASS=superpass123
RP_SASL_MECHANISM=SCRAM-SHA-256

# Console Configuration
CONSOLE_SASL_ENABLED=true

# Topic Names (Bronze Layer)
